cabal-version:   3.0
name:            beacon
version:         0.3.1.0
synopsis:        Benchmarking, exploration, and analysis of Consensus.
description:
  Tool that can be used to compare the performance of two consensus versions, through `ouroboros-consensus:db-analyser`.

license:         Apache-2.0
license-files:
  LICENSE
  NOTICE

copyright:       2023-2026 Intersect.
author:          IOHK Engineering Team
maintainer:      operations@iohk.io
category:        Network
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

flag plots
  description:
    Render measurement scatter plots via Chart-cairo. Disabling this drops
    cairo, glib, fontconfig, freetype, pixman and the X11 client libraries
    from the closure -- 12 of the 28 shared libraries an otherwise-identical
    build carries -- which matters for producing a self-contained, statically
    linked distributable. A benchmark run itself never plots.
  default:     True
  manual:      True

executable beacon
  hs-source-dirs:     app
  main-is:            beacon.hs
  other-modules:
    Cardano.Beacon.Benchmark
    Cardano.Beacon.CDF
    Cardano.Beacon.Chain
    Cardano.Beacon.CLI
    Cardano.Beacon.Compare
    Cardano.Beacon.Console
    Cardano.Beacon.Plot
    Cardano.Beacon.Provenance
    Cardano.Beacon.Run
    Cardano.Beacon.RunMeta
    Cardano.Beacon.SlotDataPoint
    Cardano.Beacon.Types
    Paths_beacon

  autogen-modules:    Paths_beacon
  default-language:   Haskell2010
  default-extensions:
    LambdaCase
    NamedFieldPuns
    ViewPatterns

  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Widentities -Wredundant-constraints
    -Wmissing-export-lists -Wunused-packages
    -Wno-unticked-promoted-constructors

  if impl(ghc >=9.8)
    ghc-options: -Wno-x-partial

  build-depends:
    , aeson                 >=2.1.2
    , ansi-terminal
    , base
    , bytestring
    , cabal-plan
    , cardano-slotting
    , containers
    , directory
    , extra
    , filepath
    , fingertree
    , hostname
    , optparse-applicative
    , process
    , statistics
    , text
    , time
    , unix
    , unix-compat
    , validation-selective
    , vector
    , vector-algorithms

  if flag(plots)
    hs-source-dirs: plots
    build-depends:
      , Chart        >=1.9
      , Chart-cairo  >=1.9

  else
    hs-source-dirs: no-plots

-- , ouroboros-consensus-cardano:unstable-cardano-tools  >= 0.12.1
